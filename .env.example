# ---------------------------------------------------------------------------
# TLS RADAR — environment variables
# Copy to .env.local for local development.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project URL and anon (public) key — safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Never expose to the browser. Used by the
# monitoring runner and migration/seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used for Supabase redirect URLs (auth callback).
# Use a tunnel (e.g. `next dev` + ngrok) for email links during development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Availability provider --------------------------------------------------
# mock (default) — deterministic local simulation, never contacts TLScontact.
# official — explicit stub; does NOT contact any external system and returns a
#            clear "not configured" error until a permitted integration exists.
TLS_PROVIDER=mock

# Mock provider behaviour (dev/test only):
#   MOCK_PROVIDER_MODE=realistic | always_available | never_available
#   MOCK_PROVIDER_FAIL_EVERY=n        (simulate a failure every n checks)
#   MOCK_PROVIDER_MIN_INTERVAL_MS=60000
MOCK_PROVIDER_MODE=realistic

# --- Notifications -----------------------------------------------------------
# Email delivery. When unset, email notifications are recorded in the database
# and logged but not sent to an external provider (local development).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TLS RADAR <no-reply@yourdomain.com>

# --- Operations --------------------------------------------------------------
# Secret required by the background monitoring cron endpoint (X-Cron-Secret).
CRON_SECRET=change-me-to-a-long-random-string

# Server logging level: debug | info | warn | error
LOG_LEVEL=info

# Official provider documentation reference (optional, informational only).
TLS_OFFICIAL_INTEGRATION_DOC_URL=
TLS_OFFICIAL_PROVIDER_CONFIGURED=false
